# Copy to .env and fill in. Never commit .env.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=yourname.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourname.pythonanywhere.com

# Shared login for the budget. bootstrap_admin reads these.
BUDGET_ADMIN_USER=teresa
BUDGET_ADMIN_PASSWORD=replace-me

# Shared secret the deploy workflow uses to call /_deploy/finalize/.
# Leave unset to disable that endpoint entirely.
DEPLOY_TOKEN=replace-me

# Optional: keep the database outside the deployed source tree.
# BUDGET_DB_PATH=/home/yourname/budget-data/db.sqlite3
